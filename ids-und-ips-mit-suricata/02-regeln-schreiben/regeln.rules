# Modul 2: eigene Regeln. SIDs ab 1000000 sind für lokale Regeln üblich.
alert http any any -> any any (msg:"LAB Pfad beginnt mit /geheim"; flow:established,to_server; http.uri; content:"/geheim"; startswith; sid:1000001; rev:1;)
alert http any any -> any any (msg:"LAB /geheim irgendwo in der URL"; flow:established,to_server; http.uri; content:"/geheim"; sid:1000002; rev:1;)
alert http any any -> any any (msg:"LAB User-Agent sqlmap (nocase)"; flow:established,to_server; http.user_agent; content:"SQLMAP"; nocase; sid:1000003; rev:1;)
alert http any any -> any any (msg:"LAB HTTP-Antwort 200"; flow:established,to_client; http.stat_code; content:"200"; sid:1000004; rev:1;)
