# Modul 8: Regelsatz des Abschlussprojekts (Webserver 127.0.0.1:8080, DNS, TLS, Scan).
alert http any any -> any any (msg:"PROJ Zugriff auf /geheim"; flow:established,to_server; http.uri; content:"/geheim"; startswith; classtype:policy-violation; sid:1000801; rev:1;)
alert http any any -> any any (msg:"PROJ Scanner-User-Agent"; flow:established,to_server; http.user_agent; content:"sqlmap"; nocase; classtype:web-application-attack; sid:1000802; rev:1;)
alert http any any -> any any (msg:"PROJ Pfad ../"; flow:established,to_server; http.uri.raw; content:"../"; classtype:web-application-attack; sid:1000803; rev:1;)
alert dns any any -> any any (msg:"PROJ DNS-Tunnel-Verdacht"; dns.query; content:"tunnel"; classtype:bad-unknown; sid:1000804; rev:1;)
alert tls any any -> any any (msg:"PROJ TLS-Name shop.example.org"; tls.sni; content:"shop.example.org"; classtype:policy-violation; sid:1000805; rev:1;)
alert tcp any any -> any [21,22,23,3389] (msg:"PROJ Verbindung zu Verwaltungsport"; flow:to_server; flags:S,12; threshold:type limit, track by_src, count 1, seconds 60; classtype:attempted-recon; sid:1000806; rev:1;)
